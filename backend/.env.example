# AquaLora Backend Environment Variables

# PostgreSQL Database Connection String
# Local Docker Compose default:
DATABASE_URL=postgresql://aqualora:aqualora123@localhost:5432/aqualora

# For Azure Database for PostgreSQL (or Supabase / Neon):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require

# Super Admin Initial Credentials
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=change-this-admin-password

# JWT Authentication Secret Key (generate a secure random 32+ character string)
JWT_SECRET=change-this-long-random-jwt-secret

# Server Port (Azure App Service sets this automatically)
PORT=8000
