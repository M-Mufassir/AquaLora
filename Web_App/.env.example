# PostgreSQL
POSTGRES_DB=aqualora
POSTGRES_USER=aqualora
POSTGRES_PASSWORD=replace-with-a-strong-password

# Backend security
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_SECRET=replace-with-a-long-random-secret

# Railway sets PORT automatically for the public frontend service.
# Local default is 5174 to avoid the existing desktop Vite port.
PORT=5174

# For Railway PostgreSQL, set this to the Railway-provided connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database
